{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "MSVC 构建当前 C/C++ 文件",
            "command": "D:\\C_CPP_Tools\\build.cmd",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 MSVC 编译当前打开的单文件 C 或 C++ 程序。"
        }
    ]
}
