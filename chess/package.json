{
  "name": "local-chess",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "prepare:stockfish": "node scripts/copy-stockfish.mjs",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "predev": "node scripts/copy-stockfish.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-stockfish.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:stockfish": "node scripts/stockfish-smoke.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
